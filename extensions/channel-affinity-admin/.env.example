# Bind to loopback by default. Put a TLS reverse proxy in front if remote access is required.
AFFINITY_LISTEN_ADDR=127.0.0.1:8089

# Use the same Redis endpoint/database that new-api uses.
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# The same upstream base address already configured by Switcher's ReverseProxy.TargetBaseAddress.
# The caller's existing Authorization token is verified by GET /api/user/self.
NEW_API_BASE_URL=http://127.0.0.1:5000
AFFINITY_NEW_API_AUTH_TIMEOUT_SECONDS=5

# This value MUST equal the external-admin rule's effective TTL in new-api.
AFFINITY_RULE_NAME=external-admin-user-channel-v1
AFFINITY_TTL_SECONDS=3600

# Keep false in the first rollout: bindings must specify a real group.
AFFINITY_ALLOW_AUTO_GROUP=false

# Optional defense in depth for direct callers. These are checked against the TCP peer address.
# AFFINITY_ALLOWED_CIDRS=127.0.0.1/32,10.0.0.0/8

# Separate from new-api's affinity namespace; Redis Stream audit log.
AFFINITY_AUDIT_STREAM=new-api:channel_affinity_admin:v1:audit
AFFINITY_REDIS_TIMEOUT_SECONDS=3
